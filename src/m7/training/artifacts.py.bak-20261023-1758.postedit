"""Local artifact inspection; imports no model libraries and never downloads."""
from __future__ import annotations

import hashlib
import importlib.metadata
import json
from pathlib import Path
import platform

from .validation import digest, identifier, shape


def no_links(path: Path) -> None:
    if path.is_symlink() or (hasattr(path, "is_junction") and path.is_junction()):
        raise ValueError("artifact_link_forbidden")


def local_path(root: Path, relative: str) -> Path:
    candidate = root / relative
    for part in (candidate, *candidate.parents):
        no_links(part)
        if part == root:
            break
    resolved = candidate.resolve(strict=True)
    if not resolved.is_relative_to(root):
        raise ValueError("artifact_outside_staging")
    return resolved


def file_sha256(path: Path) -> str:
    no_links(path)
    if not path.is_file():
        raise ValueError("artifact_file_required")
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def tree_sha256(path: Path) -> str:
    """Hash sorted [POSIX relative filename, file SHA] pairs via canonical JSON."""
    no_links(path)
    if not path.is_dir():
        raise ValueError("artifact_tree_required")
    rows = []
    for child in sorted(path.rglob("*")):
        no_links(child)
        if child.is_file():
            rows.append([child.relative_to(path).as_posix(), file_sha256(child)])
        elif not child.is_dir():
            raise ValueError("nonregular_artifact")
    if not rows:
        raise ValueError("empty_artifact_tree")
    return digest(rows)


def _unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate_json_key")
        result[key] = value
    return result


def _nonfinite(_):
    raise ValueError("nonfinite_json")


def load_object(path: Path, *, max_bytes: int = 32_000_000) -> dict:
    if path.stat().st_size > max_bytes:
        raise ValueError("artifact_too_large")
    value = json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=_unique,
                       parse_constant=_nonfinite)
    if type(value) is not dict:
        raise ValueError("object_required")
    return value


def inspect_artifacts(plan: dict, root: Path, *, check_environment: bool = True) -> tuple[dict, dict]:
    paths = {}
    for key, pin in plan["artifacts"].items():
        path = local_path(root, pin["path"])
        actual = tree_sha256(path) if pin["kind"] == "tree" else file_sha256(path)
        if actual != pin["sha256"]:
            raise ValueError("local_artifact_hash_mismatch")
        paths[key] = path
    license_packet = load_object(paths["license_packet"])
    shape(license_packet, {"schema_version", "approved", "approved_by", "training_allowed",
                           "derivatives_allowed", "artifacts"})
    if (license_packet["schema_version"] != "LicensePacket/v1" or
            license_packet["approved"] is not True or license_packet["training_allowed"] is not True or
            license_packet["derivatives_allowed"] is not True or not license_packet["approved_by"] or
            license_packet["artifacts"] != {k: plan["artifacts"][k]["sha256"]
                                             for k in ("model", "tokenizer", "train", "dev")}):
        raise ValueError("license_scope_mismatch")
    identifier(license_packet["approved_by"])
    custody = load_object(paths["custody_audit"])
    shape(custody, {"schema_version", "edition_id", "approved", "author_id", "auditor_id",
                    "allowed_splits", "train_sha256", "dev_sha256", "test_access_allowed"})
    if (custody["schema_version"] != "TrainingCustody/v1" or custody["approved"] is not True or
            custody["edition_id"] != plan["edition_id"] or
            custody["author_id"] == custody["auditor_id"] or not custody["author_id"] or
            not custody["auditor_id"] or custody["allowed_splits"] != ["train", "dev"] or
            custody["test_access_allowed"] is not False or
            any(custody[k + "_sha256"] != plan["artifacts"][k]["sha256"] for k in ("train", "dev"))):
        raise ValueError("custody_scope_mismatch")
    identifier(custody["author_id"])
    identifier(custody["auditor_id"])
    environment = load_object(paths["environment"])
    shape(environment, {"schema_version", "python", "packages", "resource_id", "device"})
    if (environment["schema_version"] != "TrainingEnvironment/v1" or
            environment["resource_id"] != plan["resource_id"] or environment["device"] not in ("cpu", "cuda:0")):
        raise ValueError("environment_scope_mismatch")
    shape(environment["packages"], {"gliner", "torch", "transformers", "accelerate", "safetensors"})
    if check_environment:
        if platform.python_version() != environment["python"]:
            raise ValueError("python_environment_mismatch")
        try:
            versions = {key: importlib.metadata.version(key) for key in environment["packages"]}
        except importlib.metadata.PackageNotFoundError:
            raise ValueError("training_dependency_unavailable") from None
        if versions != environment["packages"]:
            raise ValueError("package_environment_mismatch")
    config = load_object(paths["config"])
    shape(config, {"schema_version", "labels", "label_descriptions", "max_message_codepoints", "max_model_tokens",
                   "decoder_sha256", "label_descriptions_sha256"})
    if (config["schema_version"] != "TrainingConfig/v1" or
            config["labels"] != ["NAME", "EMAIL", "PHONE", "ACCOUNT_ID"] or
            config["max_message_codepoints"] != 1024 or
            type(config["max_model_tokens"]) is not int or not 1 <= config["max_model_tokens"] <= 8192):
        raise ValueError("unsupported_training_config")
    descriptions = config["label_descriptions"]
    if (type(descriptions) is not list or len(descriptions) != 4 or
            any(type(v) is not str or not v.strip() or len(v) > 128 for v in descriptions) or
            len(set(descriptions)) != 4 or config["label_descriptions_sha256"] != digest(descriptions)):
        raise ValueError("training_label_description_pin_mismatch")
    from .validation import hash_pin
    hash_pin(config["decoder_sha256"])
    hash_pin(config["label_descriptions_sha256"])
    return paths, {"environment": environment, "config": config}


def load_training_data(path: Path, expected_split: str) -> list[dict]:
    """Only staged labelled train/dev records. No fallback split or test loader."""
    from m7.contracts import LogRecord, Span

    bundle = load_object(path)
    shape(bundle, {"schema_version", "split", "records"})
    if bundle["schema_version"] != "TrainingDataset/v1" or bundle["split"] != expected_split:
        raise ValueError("training_split_required")
    if type(bundle["records"]) is not list or not 1 <= len(bundle["records"]) <= 100_000:
        raise ValueError("invalid_training_data_count")
    ids, hashes, result = set(), set(), []
    for row in bundle["records"]:
        shape(row, {"record", "gold"})
        record = LogRecord.model_validate(row["record"])
        if record.split_id != expected_split or record.record_id in ids:
            raise ValueError("record_split_or_identity_mismatch")
        ids.add(record.record_id)
        if record.content_sha256 in hashes:
            raise ValueError("duplicate_training_message")
        hashes.add(record.content_sha256)
        if type(row["gold"]) is not list or len(row["gold"]) > 128:
            raise ValueError("invalid_gold")
        spans = []
        for entry in row["gold"]:
            shape(entry, {"start", "end", "label"})
            span = Span.model_validate(entry)
            if span.end > len(record.log.message):
                raise ValueError("invalid_gold_bounds")
            spans.append(span)
        if len({(s.start, s.end, s.label) for s in spans}) != len(spans):
            raise ValueError("duplicate_gold")
        result.append({"record": record, "spans": tuple(spans)})
    return result

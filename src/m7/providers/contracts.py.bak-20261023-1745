"""Pinned adapter configuration and explicit execution authority, never credentials."""
from __future__ import annotations

from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path, PurePosixPath
from typing import Annotated, Literal

from pydantic import Field, model_validator

from m7.contracts import Boundary, Digest, Identifier


class AdapterFault(Exception):
    """Fixed enum only: never include a vendor body, message, path or exception."""

    def __init__(self, code: str):
        if code not in {"permit_required", "unavailable", "invalid_output", "truncated",
                        "backend_failure", "cancelled"}:
            code = "backend_failure"
        self.code = code
        super().__init__(code)


def config_digest(config: Boundary) -> str:
    encoded = json.dumps(config.model_dump(mode="json"), sort_keys=True,
                         separators=(",", ":"), ensure_ascii=True, allow_nan=False)
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()


class ExecutionPermit(Boundary):
    """An externally approved receipt, not a self-authenticating authorization.

    An operator must verify its issuer/signature outside this library before use.
    No approved sample permit is shipped. All times must have an explicit timezone.
    """

    schema_version: Literal["AdapterPermit/v1"] = "AdapterPermit/v1"
    permit_id: Identifier
    run_id: Identifier
    model_id: Identifier
    scope: Literal["local_inference", "frontier_inference"]
    config_sha256: Digest
    authorization_sha256: Digest
    license_receipt_sha256: Digest
    resource_receipt_sha256: Digest
    issued_at: Annotated[str, Field(min_length=1, max_length=64)]
    expires_at: Annotated[str, Field(min_length=1, max_length=64)]
    approved: Literal[True]

    def check(self, *, run_id: str, model_id: str, scope: str,
              config_sha256: str, now: datetime | None = None) -> None:
        try:
            issued = datetime.fromisoformat(self.issued_at.replace("Z", "+00:00"))
            expires = datetime.fromisoformat(self.expires_at.replace("Z", "+00:00"))
            clock = now if now is not None else datetime.now(timezone.utc)
            if any(t.tzinfo is None or t.utcoffset() is None for t in (issued, expires, clock)):
                raise ValueError("timezone_required")
            valid_time = issued <= clock < expires and issued < expires
        except (TypeError, ValueError, OverflowError):
            raise AdapterFault("permit_required") from None
        if (not valid_time or self.run_id != run_id or self.model_id != model_id
                or self.scope != scope or self.config_sha256 != config_sha256):
            raise AdapterFault("permit_required")


class FilePin(Boundary):
    relative_path: Annotated[str, Field(min_length=1, max_length=512)]
    sha256: Digest


class DecoderConfig(Boundary):
    schema_version: Literal["Decoder/v1"] = "Decoder/v1"
    # Label descriptions and their order are shared by base/fine, never test-tuned.
    labels: tuple[str, str, str, str] = ("person full name", "email address",
                                      "phone number", "account identifier")
    threshold: Annotated[float, Field(ge=0, le=1, allow_inf_nan=False)] = 0.5
    threshold_selection_sha256: Digest
    flat_ner: Literal[False] = False
    multi_label: Literal[True] = True
    offset_unit: Literal["unicode_codepoint"] = "unicode_codepoint"

    @model_validator(mode="after")
    def distinct_labels(self) -> DecoderConfig:
        if (len(set(self.labels)) != 4 or any(not label.strip() or len(label) > 128
                or any(0xD800 <= ord(char) <= 0xDFFF for char in label) for label in self.labels)):
            raise ValueError("invalid_label_descriptions")
        return self


class LocalModelConfig(Boundary):
    schema_version: Literal["LocalAdapter/v1"] = "LocalAdapter/v1"
    arm: Literal["base", "finetuned"]
    model_id: Identifier
    base_revision: Identifier
    artifact_root: Annotated[str, Field(min_length=1, max_length=4096)]
    model_subdir: str
    backbone_subdir: str
    files: Annotated[tuple[FilePin, ...], Field(min_length=1, max_length=4096)]
    weights_sha256: Digest
    tokenizer_sha256: Digest
    # Exact optional library versions require a later approved environment lock.
    gliner_version: Identifier
    transformers_version: Identifier
    decoder: DecoderConfig
    max_input_tokens: Annotated[int, Field(ge=1, le=131072)]
    max_words: Annotated[int, Field(ge=1, le=1024)]
    device: Literal["cpu", "cuda"] = "cpu"


def _relative(name: str) -> PurePosixPath:
    path = PurePosixPath(name)
    if (not name or "\\" in name or ":" in name or path.is_absolute()
            or any(part in ("", ".", "..") for part in name.split("/"))):
        raise AdapterFault("permit_required")
    return path


def verify_artifacts(config: LocalModelConfig) -> tuple[Path, Path]:
    """Exact closed manifest, no symlinks, executable Python or pickle weights.

    Call only after authorization; hashes are of artifact files, never entity values.
    The approved artifact root must be immutable while loaded (TOCTOU limitation).
    """
    root = Path(config.artifact_root)
    if (not root.is_absolute() or not root.is_dir() or root.is_symlink()
            or (hasattr(root, "is_junction") and root.is_junction())):
        raise AdapterFault("permit_required")
    root = root.resolve(strict=True)
    expected = {}
    for pin in config.files:
        relative = _relative(pin.relative_path)
        if pin.relative_path in expected:
            raise AdapterFault("permit_required")
        expected[relative.as_posix()] = pin.sha256
    if not expected or len(expected) > 4096:
        raise AdapterFault("permit_required")
    observed = set()
    for path in root.rglob("*"):
        if path.is_symlink() or (hasattr(path, "is_junction") and path.is_junction()):
            raise AdapterFault("permit_required")
        if not path.is_file():
            continue
        relative = path.relative_to(root).as_posix()
        if path.suffix.lower() in {".py", ".pyc", ".pkl", ".pickle", ".bin", ".pt", ".pth"}:
            raise AdapterFault("permit_required")
        if relative not in expected:
            raise AdapterFault("permit_required")
        digest = hashlib.sha256()
        with path.open("rb") as source:
            for block in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(block)
        if digest.hexdigest() != expected[relative]:
            raise AdapterFault("permit_required")
        observed.add(relative)
    if observed != set(expected):
        raise AdapterFault("permit_required")
    model = root.joinpath(*_relative(config.model_subdir).parts)
    backbone = root.joinpath(*_relative(config.backbone_subdir).parts)
    if not model.is_dir() or not backbone.is_dir():
        raise AdapterFault("permit_required")
    weight_path = config.model_subdir + "/model.safetensors"
    model_weights = {name for name in expected if name.startswith(config.model_subdir + "/")
                     and name.endswith(".safetensors")}
    if model_weights != {weight_path} or expected.get(weight_path) != config.weights_sha256:
        raise AdapterFault("permit_required")
    # Tokenizer fingerprint is a canonical hash of the entire pinned backbone subtree.
    tokenizer_pins = {name: digest for name, digest in expected.items()
                      if name.startswith(config.backbone_subdir + "/")}
    if not tokenizer_pins or hashlib.sha256(json.dumps(tokenizer_pins, sort_keys=True,
            separators=(",", ":")).encode()).hexdigest() != config.tokenizer_sha256:
        raise AdapterFault("permit_required")
    return model, backbone


class FrontierConfig(Boundary):
    schema_version: Literal["FrontierAdapter/v1"] = "FrontierAdapter/v1"
    model_id: Identifier
    provider_model: Identifier
    model_revision_sha256: Digest
    endpoint: Annotated[str, Field(min_length=1, max_length=2048)]
    protocol: Literal["chat-completions/v1"] = "chat-completions/v1"
    provider_terms_sha256: Digest
    prompt_sha256: Digest
    token_counter_sha256: Digest
    max_input_tokens: Annotated[int, Field(ge=1, le=131072)]
    max_output_tokens: Annotated[int, Field(ge=1, le=32768)]
    context_window_tokens: Annotated[int, Field(ge=2, le=262144)]
    max_request_bytes: Annotated[int, Field(ge=1024, le=1048576)] = 65536
    max_response_bytes: Annotated[int, Field(ge=1024, le=1048576)] = 262144
    timeout_seconds: Annotated[float, Field(gt=0, le=120, allow_inf_nan=False)] = 30.0

